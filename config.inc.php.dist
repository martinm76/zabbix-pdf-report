<?php
/**
 * zabbix-pdf-report — 2.x configuration template.
 * Copy this file to config.inc.php and edit for your environment.
 *
 * Requires:
 *   - Zabbix 7.0 or newer
 *   - PHP 8.0 or newer
 *
 * For older Zabbix releases, use the legacy-1.x branch.
 */

// ---------------------------------------------------------------------
// Application behaviour
// ---------------------------------------------------------------------

// If $user_login is 1, prompt for credentials via the login page.
// If 0, use the $z_user / $z_pass values below silently.
$user_login      = 1;

// If 1, requests originating from 127.0.0.1 will use the $z_user / $z_pass
// values from this file (handy for cron-driven email reports).
$allow_localhost = 1;

$version         = '2.2.0';

// ---------------------------------------------------------------------
// Zabbix server connection
// ---------------------------------------------------------------------

// Base URL of your Zabbix frontend (trailing slash optional).
// Examples:
//   $z_server = 'https://zabbix.example.com/';        // domain root, default port
//   $z_server = 'https://zabbix.example.com/zabbix/'; // subdirectory install
//   $z_server = 'http://192.168.1.10:8080/';          // non-standard port
//   $z_server = 'http://your-zabbix-host:8080/zabbix/'
$z_server = 'http://localhost/zabbix/';

// Authentication mode for the JSON-RPC API:
//   'token'    — recommended: use a pre-created API token from
//                Users → API tokens in the Zabbix UI. No username/password
//                is sent to the API. Note that graph rendering still needs
//                $z_user / $z_pass below because chart2.php does NOT accept
//                bearer tokens.
//   'userpass' — classic: log in with username and password to obtain a
//                short-lived session token.
$z_auth_mode = 'userpass';

// Used when $z_auth_mode = 'token'.
$z_api_token = '';

// Frontend credentials. Always required for graph PNG rendering
// (chart2.php / chart.php) regardless of $z_auth_mode.
$z_user = 'Admin';
$z_pass = 'YourPasswordHere';

// Verify TLS certificate of the Zabbix server.
// Set false for self-signed deployments.
$z_verify_tls = false;

// ---------------------------------------------------------------------
// Report contents (unchanged from 1.x)
// ---------------------------------------------------------------------

$items  = [
    'system information'         => 'string',
    'uptime'                     => 'seconds',
    'boot time'                  => 'datetime',
    'total memory'               => 'bytes',
    'available memory'           => 'bytes',
    'Free disk space'            => 'number',
    'Free swap space in %'       => 'number',
    'version of zabbix_agent'    => 'string',
    'services'                   => 'string',
    'update'                     => 'number',
    'certificate'                => 'string',
    'advanced ntp'               => 'string',
    'Interface speed'            => 'bits',
    'Operational status'         => 'updown',
    'Alias of interface'         => 'string',
];

$trends = [
    'ICMP ping'                  => 'updown',
    'ICMP loss'                  => 'number',
    'ICMP response'              => 'ms',
    'BatteryCharge'              => 'number',
    'Battery capacity'           => 'number',
    'voltage'                    => 'number',
    'output power'               => 'number',
    'CPU Idle Time'              => 'number',
    '15 min average'             => 'number',
    'Temp'                       => 'number',
    'Watt'                       => 'number',
    'uptime'                     => 'seconds',
    'transactions per second'    => 'number',
];

$showdates = false;

$mygraphs     = '#(Ping|CPU load|CPU usage|CPU util|processor|Disk space|Swap|Ethernet|Memory usage|^Traffic on |traffic on eth)#';
$myitemgraphs = '#(Utilization of|farm connection|Average Latency|Number of processes|Cache % Hit)#';

// ---------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------

$z_tmp_path        = './tmp';
$pdf_report_dir    = './reports';
$pdf_report_url    = './reports';
$paper_format      = 'A4';        // A4, LETTER, LEGAL, …
$paper_orientation = 'portrait';  // portrait | landscape
$timezone          = 'Europe/Oslo';
$pdf_logo          = './images/general/zabbix.png';
$company_name      = 'YourCompany Name';
$hide_company_name = false;

// Placement of PDF Logo:
$maxWidth  = 300;
$maxHeight = 120;
$offsetX   = 30; # How far in on the page should be push the logo
$offsetY   = 40; # How far up/down should be push the logo?
$anchor    = 'bottom-left'; # What location on the page should be use as basis for the offsets?

// ---------------------------------------------------------------------
// Derived values — DO NOT EDIT BELOW THIS LINE
// ---------------------------------------------------------------------

if (substr($z_server, -1) !== '/') {
    $z_server .= '/';
}

$z_tmp_cookies = '/tmp/';
$z_url_index   = $z_server . 'index.php';
$z_url_graph   = $z_server . 'chart2.php';
$z_item_graph  = $z_server . 'chart.php';
$z_url_api     = $z_server . 'api_jsonrpc.php';
$z_login_data  = http_build_query([
    'name'      => $z_user,
    'password'  => $z_pass,
    'autologin' => 1,
    'enter'     => 'Sign in',
]);

?>
